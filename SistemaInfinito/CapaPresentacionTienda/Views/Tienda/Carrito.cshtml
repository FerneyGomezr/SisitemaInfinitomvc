@*@model CapaEntidad.Cliente*@
@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row">
        <div class="col-sm-13">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <!--detalle del producto-->
                        <div class="col-sm-8">
                            <div class="me-2">
                                <div class="d-flex justify-content-between">
                                    <h5> Detalle carrito</h5>
                                    <a class="btn btn-primary" href="@Url.Action("Index","Tienda")">
                                        <i class="fas fa-cart-plus"></i> Seguir Comprando
                                    </a>
                                </div>
                                <!--barra de separacion horizontal-->
                                <hr class="mt-3 mb-2" />
                                <div class="d-flex justify-content-end">
                                    <label class="align-self-center"><b>Total: $<span id="totalcarro">0</span></b></label>

                                </div>
                                <hr class="mt-3 mb-2" />
                                <div id="productos-carrito">


                                    <div class="card mb-2 card-producto">
                                        <div class="card-body">
                                            <div class="row">

                                                <div class="col-sm-2 align-self-center d-flex justify-content-center">
                                                    <img class="rounded" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" style="width:100px;height:100px" />
                                                </div>

                                                <div class="col-sm-2 align-self-center">
                                                    <span class="font-wight-bold d-block"> Marca:</span>
                                                    <span> Producto:</span>
                                                </div>

                                                <div class="col-sm-2 align-self-center">
                                                    <span class="font-wight-bold d-block"> Precio: s/. 1500</span>
                                                </div>


                                                <div class="col-sm-2 align-self-center">
                                                    <div class="d-flex">
                                                        <button class="btn btn-outline-secondary btn-restar rounded-0">
                                                            <i class="fas fa-minus"></i>
                                                        </button>
                                                        <input class="form-control input-cantidad p-1 text-center rounded-0" disables style="width:40px" />
                                                        <button class="btn btn-outline-secondary btn-sumar rounded-0">
                                                            <i class="fas fa-plus"></i>

                                                        </button>
                                                    </div>
                                                </div>


                                                <div class="col-sm-2 align-self-center">
                                                    <button class="btn btn-outline-danger btn-eliminar rounded-0">
                                                        <i class="fa fa-trash-alt"></i> Eliminar
                                                    </button>
                                                </div>



                                            </div>

                                        </div>
                                    </div>

                                </div>
                                <!--totales carrito-->
                                <!--<div class="d-flex justify-content-end">
                                    <label class="align-self-center"><b>Total: $<span id="totalcarro">0</span></b></label>

                                </div>-->


                            </div>


                        </div>

                        <!--detalle del envio-->
                        <div class="col-sm-4">
                            <div class="card">
                                <div class="card-body bg-light">
                                    <h5 class="card-title"> Detalle Envío</h5>
                                    <form>
                                        <div class="mb-2">
                                            <label for="cbodepartamento" class="form-label">Departamento: </label>
                                            <select class="form-select form-select-sm" id="cbodepartamento"></select>

                                        </div>
                                        <div class="mb-2">
                                            <label for="cbomunicipio" class="form-label">municipio</label>
                                            <select class="form-select form-select-sm" id="cbomunicipio"></select>

                                        </div>

                                        <div class="mb-2">
                                            <label for="txtdireccion" class="form-label">Dirección: </label>
                                            <input type="text" class="form-control form-control-sm" id="txtdireccion" />

                                        </div>
                                        <div class="mb-2">
                                            <label for="txtnombrecontacto" class="form-label">Nombre Contacto: </label>
                                            <input type="text" class="form-control form-control-sm" id="txtnombrecontacto" />

                                        </div>
                                        <div class="mb-2">
                                            <label for="txttelefono" class="form-label">Teléfono</label>
                                            <input type="text" class="form-control form-control-sm" id="txttelefono" />

                                        </div>
                                        <!--la class d-grid hace que se ajuste al ancho-->
                                        <div class="d-grid">
                                            <button class="btn btn-success" type="button" onclick="RealizarPago()">
                                                <i class="fab fa-paypal"></i> Terminar y Procesar Pago
                                            </button>
                                        </div>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
@section scripts{

    <script>
    $(document).ready(function () {
        jQuery.ajax({
            url: "@Url.Action("ListarProductosCarrito", "Tienda")",
            type: "POST",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
               $("#productos-carrito").html("");
               $("#productos-carrito").LoadingOverlay("hide");


                $.each(response.data, function (index, item) {

                    $("<div>").addClass("card mb-2 card-producto").append(
                        $("<div>").addClass("card-body").append(
                            $("<div>").addClass("row").append(
                                //1
                                $("<div>").addClass("col-sm-2 align-self-center d-flex justify-content-center").append(

                                    $("<img>").addClass("rounded").attr({ "src": "data:image/" + item.oProducto.Extension + ";base64," + item.oProducto.base64 })
                                        .css({ "width": "100px", "height": "100px" })
                                ),
                                //2
                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<span>").addClass("font-wight-bold d-block").text(item.oProducto.oMarca.Descripcion),
                                    $("<span>").text(item.oProducto.Nombre)
                                ),
                                //3
                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<span>").text(item.oProducto.Precio.toFixed(2))
                                ),
                                //4
                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<div>").addClass("d-flex").append(

                                        $("<button>").addClass("btn btn-outline-secondary btn-restar rounded-0").append($("<i>").addClass("fas fa-minus")),
                                        $("<input>").addClass("form-control input-cantidad p-1 text-center rounded-0").attr({"disabled": "disabled"})
                                            .css({ "width": "40px"})
                                            .data("oProducto", item.oProducto)
                                            .val(item.Cantidad),
                                        $("<button>").addClass("btn btn-outline-secondary btn-sumar rounded-0").append($("<i>").addClass("fas fa-plus")),

                                    )

                                ),
                                //5
                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<button>").addClass("btn btn-outline-danger btn-eliminar").append($("<i>").addClass("fas fa-trash-alt"), "Eliminar")
                                        .data("idproducto", item.oProducto.IdProducto),

                                 )

                            )
                        )
                    ).appendTo("#productos-carrito")

                })

                SumarTotal();

            },
            error: function (error) {
                $("#productos-carrito").LoadingOverlay("hide");
            },
            beforeSend: function () {
                $("#productos-carrito").LoadingOverlay("show");
            }

        })




        ListarDepartamento();

    });

        function ListarDepartamento() {
             $("<option>").attr({ "value": "00","disabled":"disabled","selected":"true" }).text("Seleccionar").appendTo("#cbodepartamento")
            jQuery.ajax({
                url: "@Url.Action("ObtenerDepartamento", "Tienda")",
                type: "POST",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.data != null ) {

                        $.each(response.data, function (index, item) {
                            $("<option>").attr({ "value": item.IdDepartamento }).text(item.Descripcion).appendTo("#cbodepartamento");
                        });

                        ListarMunicipios();
                    }
                }
            })
        }
        $("#cbodepartamento").on("change", function () {
            ListarMunicipios();
        })

        function ListarMunicipios() {
            $("#cbomunicipio").html("")

            $("<option>").attr({ "value": "00", "disabled": "disabled", "selected": "true" }).text("Seleccionar").appendTo("#cbomunicipio")
                 jQuery.ajax({
                     url: "@Url.Action("ObtenerMunicipio", "Tienda")",
                     type: "POST",
                     data: JSON.stringify({ IdDepartamento: $("#cbodepartamento option:selected").val() }),
                     dataType: "json",
                     contentType: "application/json; charset=utf-8",
                     success: function (response) {
                         if (response.data != null) {

                             $.each(response.data, function (index, item) {
                                 $("<option>").attr({ "value": item.IdMunicipio}).text(item.Descripcion).appendTo("#cbomunicipio")
                             })


                         }
                     }
                 })
        }

        function SumarTotal() {
            var sumaTotal = parseFloat(0)
            $("input.input-cantidad").each(function (i) {
                var precio = $(this).data("oProducto").Precio;
                var cantidad = parseFloat($(this).val())

                var subtotal = precio * cantidad;
                sumaTotal += subtotal
            })
            console.log(sumaTotal)
            $("#totalcarro").text(sumaTotal.toFixed(2))
            $("#totalcarro").data("sumatotal", sumaTotal)
        }


        //sumar articulos
        $(document).on("click", ".btn-sumar", function () {
            var div_contenedor = $(this).parent("div.d-flex");

            var input_cantidad = $(div_contenedor).find("input.input-cantidad");

            var btn = $(this)
            var idproducto = $(input_cantidad).data("oProducto").IdProducto

            jQuery.ajax({
                url: "@Url.Action("OperacionCarrito", "Tienda")",
                type: "POST",
                data: JSON.stringify({ idproducto: idproducto, sumar:true }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $(btn).LoadingOverlay("hide")
                    if (data.respuesta) {
                        var cantidad = parseInt($(input_cantidad).val()) + 1;
                        $(input_cantidad).val(cantidad)
                        SumarTotal()
                    } else {
                        swal("", data.mensaje, "warning")
                    }
                },
                beforeSend: function () {
                    $(btn).LoadingOverlay("show")
                },
                error: function (error) {
                    $(btn).LoadingOverlay("hide")
}

            })
        })
        //restar articulos
        $(document).on("click", ".btn-restar", function () {
            var div_contenedor = $(this).parent("div.d-flex");

            var input_cantidad = $(div_contenedor).find("input.input-cantidad");

            var btn = $(this)
            var idproducto = $(input_cantidad).data("oProducto").IdProducto
            var cantidad = parseInt($(input_cantidad).val()) - 1;
            if (cantidad >= 1) {
                jQuery.ajax({
                    url: "@Url.Action("OperacionCarrito", "Tienda")",
                    type: "POST",
                    data: JSON.stringify({ idproducto: idproducto, sumar: false }),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {

                        $(btn).LoadingOverlay("hide")
                        if (data.respuesta) {

                            $(input_cantidad).val(cantidad)
                            SumarTotal()
                        } else {
                            swal("Error", "No se pudo agregar el producto al carrito", "error")
                        }
                    },
                    beforeSend: function () {
                        $(btn).LoadingOverlay("show")
                    },
                    error: function (error) {
                        $(btn).LoadingOverlay("hide")
                    }

                })


            }

        })


        $(document).on("click", ".btn-eliminar", function () {
            var idproducto = $(this).data("idproducto");
            var card_producto = $(this).parents("div.card-producto");

             jQuery.ajax({
                url: "@Url.Action("EliminarCarrito", "Tienda")",
                type: "POST",
                data: JSON.stringify({ idproducto: idproducto }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    if (data.respuesta) {
                        card_producto.remove();
                        MostrarCantidadCarrito();
                        SumarTotal();
                    } else {
                        swal("", data.mensaje, "warning")
                    }
                },


            })
        })

        function RealizarPago() {
            if (parseInt($("#cantidadcarrito").text()) == 0) {
                swal("", "No hay productos en el carrito", "warning")
                return
            }

            else if ($("#cbodepartamento").val() == null) {
                swal("", "Seleccione un departamento", "warning")
                return
            }
            else if ($("#cbomunicipio").val() == null) {
                swal("", "Seleccione un municipio", "warning")
                return
            }
            else if ($("#txtdireccion").val() == "") {
                swal("", "Ingrese una dirección", "warning")
                return
            }
            else if ($("#txtnombrecontacto").val() == "") {
                swal("", "Ingrese un nombre de contacto", "warning")
                return
            }
            else if ($("#txttelefono").val() == "") {
                swal("", "Ingrese un teléfono", "warning")
                return
            }

            var venta = {
                TotalProducto: $("input.input-cantidad").length,
                MontoTotal: 0,
                Contacto: $("#txtnombrecontacto").val(),
                Telefono: $("#txttelefono").val(),
                Direccion: $("#txtdireccion").val(),
                IdMunicipio: $("#cbomunicipio option:selected").val(),
                IdDepartamento: $("#cbodepartamento option:selected").val(),


            }

            var lista_carrito = [];
            $("input.input-cantidad").each(function (i) {

                var producto = $(this).data("oProducto");

                var cantidad = parseFloat($(this).val())


                lista_carrito.push({

                    oProducto: producto,
                    Cantidad: cantidad
                })
            })
            jQuery.ajax({
                url: "@Url.Action("ProcesarPago", "Tienda")",
                type: "POST",
                data: JSON.stringify({ oListaCarrito: lista_carrito, oVenta: venta }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $.LoadingOverlay("hide")
                    if (data.Status) {
                        window.location.href = data.Link
                    } else {
                        swal("", "Vuelva a intentarlo mas tarde", "warning")
                    }
                },
                beforeSend: function () {
                    $.LoadingOverlay("show");
                },
                error: function (error) {
                    $.LoadingOverlay("hide")
                }

            })
        }


    </script>
}



